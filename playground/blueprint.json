{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Treinamento de Voluntários — WordCamp Brasil 2026",
		"author": "WordCamp Brasil 2026"
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "sensei-lms"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "sensei-certificates"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "setSiteLanguage",
			"language": "pt_BR"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Treinamento de Voluntários — WordCamp Brasil 2026",
				"blogdescription": "Curso para a equipe de voluntários do WCBR 2026",
				"timezone_string": "America/Sao_Paulo",
				"date_format": "j \\d\\e F \\d\\e Y",
				"permalink_structure": "/%postname%/"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/wcbr-sem-barra-admin.php",
			"data": "<?php\n/**\n * Plugin Name: WCBR 2026 — Sem barra de administração\n * Description: Esconde a barra de administração no site do curso (no Playground o visitante entra como admin).\n */\nadd_filter( 'show_admin_bar', '__return_false' );\n"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/wcbr-nome-certificado.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/wordcampbr/wcbr26-voluntariado-treinamento/main/sensei/mu-plugins/wcbr-nome-certificado.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/wcbr-certificado-ptbr.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/wordcampbr/wcbr26-voluntariado-treinamento/main/sensei/mu-plugins/wcbr-certificado-ptbr.php"
			}
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wcbr"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wcbr/modulos.json",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/wordcampbr/wcbr26-voluntariado-treinamento/main/playground/modulos.json"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wcbr/import-curso.php",
